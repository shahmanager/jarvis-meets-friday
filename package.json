{
  "name": "dual-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir work/build",
    "test:integration": "npm run build && node scripts/integration.mjs && node scripts/integration.mjs --object-storage",
    "test:team": "npm run build && node scripts/team-integration.mjs",
    "memory:install": "npm --prefix memory ci --ignore-scripts --omit=optional",
    "memory:start": "node memory/start.mjs",
    "test:office": "npm run build && node scripts/office-integration.mjs",
    "test:autonomy": "npm run build && node scripts/autonomy-integration.mjs",
    "test:capabilities": "npm run build && node scripts/capabilities-integration.mjs",
    "eval:collaboration": "node scripts/eval-collaboration.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "miniflare": "5.20261006.1-alpha",
    "tsx": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
